# Required to create a Recall.ai bot.
RECALL_API_KEY=
RECALL_REGION=us-east-1
WEBHOOK_BASE_URL=https://your-public-url.example
# Set true only while debugging: payloads can contain transcript text.
WEBHOOK_LOG_PAYLOADS=false

# Required when ANALYSIS_ENABLED=true.
OPENAI_API_KEY=
ANALYZER_MODEL=gpt-4o-mini

# Set false to verify transcription without OpenAI calls or alerts.
ANALYSIS_ENABLED=true

# Optional: enable Recall webhook signature verification.
# RECALL_WORKSPACE_SECRET=whsec_...

# Timed stream classifier and alarm gate.
ANALYSIS_INTERVAL_S=10
WINDOW_S=30
MIN_WORDS=15
MIN_NEW_WORDS=8
STABLE_WORD_DELAY_S=1
STREAK_NEEDED=2
CONFIDENCE_MIN=0.7
COOLDOWN_S=60
